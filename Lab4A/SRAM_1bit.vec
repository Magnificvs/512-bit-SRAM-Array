; Cadence Virtuoso Vector File for 1-bit SRAM

radix 1  11111  11111  1  1  1  1  1  1  1
io    i  i      i      i  i  i  i  i  i  i
vname precharge_en A<[4:0]> A_bar<[4:0]> write_en decoder_en pre_en_SA read_en sense_en data data_b
tunit ns
trise 0.005
tfall 0.005
vih 1.0
vil 0.0

;	WRITE '1' Operation
;     precharge_en || A<4:0> || A_bar<4:0> || write_en || decoder_en || pre_en_SA || read_en || sense_en || data || data_b
0     1				  00000		11111		  0			  0				1			 1			0			1		0	; Initial: all disabled
1	  0				  00000		11111		  0			  0				1			 1			0			1		0	; Precharge BL/BLB
1.5	  1				  00000		11111		  1			  0				1			 1			0			1		0	; Precharge off, write_en on
2	  1				  00000		11111		  1			  1				1			 1			0			1		0	; decoder_en on → WL high, write '1'

;	READ '1' Operation
;     precharge_en || A<4:0> || A_bar<4:0> || write_en || decoder_en || pre_en_SA || read_en || sense_en || data || data_b
; Step 1: Precharge BL/BLB AND sense amp simultaneously
3     0				  00000		11111		  0			  0				0			 1			0			1		0   ; Precharge BL/BLB; pre_en_SA=0 resets SA nodes
; Step 2: Deactivate all precharges, enable decoder + read_en
3.5   1				  00000		11111		  0			  1				1			 0			0			1		0   ; BL/BLB precharge off, SA precharge off, decoder+read_en ON
; Step 3: Fire sense_en, disable read path, sense_en stays briefly
3.8   1				  00000		11111		  0			  0				1			 1			1			1		0   ; decoder_en off, read_en off
4     1				  00000		11111		  0			  0				1			 1			0			1		0   ; sense_en off — OUT latch clocks result
4.5   0				  00000		11111		  0			  0				1			 1			0			1		0   ; Precharge BL/BLB again

;	WRITE '0' Operation
;     precharge_en || A<4:0> || A_bar<4:0> || write_en || decoder_en || pre_en_SA || read_en || sense_en || data || data_b
5	  1				  00000		11111		  1			  0				1			 1			0			0		1	; Precharge off, write_en on, data=0
6	  1				  00000		11111		  1			  1				1			 1			0			0		1	; decoder_en on → WL goes high, write '0'
6.5	  0				  00000		11111		  0			  0				1			 1			0			0		1	; decoder_en off, write_en off

;	READ '0' Operation
;     precharge_en || A<4:0> || A_bar<4:0> || write_en || decoder_en || pre_en_SA || read_en || sense_en || data || data_b
; Step 1: Precharge BL/BLB AND sense amp simultaneously
8     0				  00000		11111		  0			  0				0			 1			0			0		1   ; Precharge BL/BLB; pre_en_SA=0 resets SA nodes
; Step 2: Deactivate all precharges, enable decoder + read_en
8.5   1				  00000		11111		  0			  1				1			 0			0			0		1   ; BL/BLB precharge off, SA precharge off, decoder+read_en ON
; Step 3: Disable read path
8.8   1				  00000		11111		  0			  0				1			 1			1			0		1   ; decoder_en off, read_en off
9     1				  00000		11111		  0			  0				1			 1			0			0		1   ; sense_en off — OUT latch clocks result
9.5   0				  00000		11111		  0			  0				1			 1			0			0		1   ; Precharge